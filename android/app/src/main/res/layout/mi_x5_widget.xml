<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_ambient" style="@style/WidgetText"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Habitación —°C" android:textColor="#AAA68E" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_sleep" style="@style/WidgetIcon" android:background="@android:color/transparent"
            android:src="@drawable/widget_moon" android:contentDescription="Activar Sueño" />
        <ImageButton android:id="@+id/widget_swing" style="@style/WidgetIcon" android:background="@android:color/transparent"
            android:padding="9dp" android:src="@drawable/widget_swing" android:contentDescription="Activar oscilación vertical" />
        <ImageButton android:id="@+id/widget_power" style="@style/WidgetIcon" android:background="@android:color/transparent"
            android:src="@drawable/widget_power" android:contentDescription="Encender minisplit" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp">
        <FrameLayout android:id="@+id/widget_display" android:layout_width="146dp" android:layout_height="49dp" android:layout_gravity="center" android:contentDescription="Cambiar luz del display">
            <ImageView android:id="@+id/widget_render" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_ac" android:contentDescription="Minisplit Mirage X5" />
            <TextView android:id="@+id/widget_display_temperature" style="@style/WidgetText" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="right|center_vertical" android:gravity="center" android:text="—" android:textSize="18sp"
                android:textColor="#FFFFFF" android:shadowColor="#BBFFFFFF" android:shadowRadius="3" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/widget_down" style="@style/WidgetIcon" android:background="@drawable/widget_circle"
            android:src="@drawable/widget_minus" android:contentDescription="Bajar temperatura" />
        <TextView android:id="@+id/widget_temperature" style="@style/WidgetText" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="—°C" android:textSize="38sp" />
        <ImageButton android:id="@+id/widget_up" style="@style/WidgetIcon" android:background="@drawable/widget_circle"
            android:src="@drawable/widget_plus" android:contentDescription="Subir temperatura" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/widget_mode" style="@style/WidgetCard" android:contentDescription="Cambiar modo">
            <TextView style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Modo" android:textSize="12sp" android:textColor="#989B90" />
            <TextView android:id="@+id/widget_mode_value" style="@style/WidgetText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:layout_marginTop="3dp" />
        </LinearLayout>
        <TextView android:layout_width="8dp" android:layout_height="1dp" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/widget_fan" style="@style/WidgetCard" android:contentDescription="Cambiar velocidad del ventilador">
            <TextView style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ventilador" android:textSize="12sp" android:textColor="#989B90" />
            <TextView android:id="@+id/widget_fan_value" style="@style/WidgetText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center_vertical" android:contentDescription="Actualizar estado">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_shield" android:tint="#AAA68E" />
            <TextView android:id="@+id/widget_status" style="@style/WidgetText" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="Configura Mi X5 en la app"
                android:textSize="11sp" android:textColor="#AAA68E" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_open" style="@style/WidgetIcon" android:layout_height="32dp" android:padding="8dp"
            android:background="@android:color/transparent" android:src="@drawable/widget_settings" android:contentDescription="Abrir Mi X5" />
    </LinearLayout>
</LinearLayout>
