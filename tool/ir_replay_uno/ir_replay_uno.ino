void setup() {
  digitalWrite(IR_SEND_PIN, LOW);
  pinMode(IR_SEND_PIN, OUTPUT);
  Serial.begin(115200);
  IrSender.begin(IR_SEND_PIN, USE_DEFAULT_FEEDBACK_LED_PIN);
  Serial.println(F("Mi X5: emisor D3 listo. Capturas a 23 C; pueden restaurar otros ajustes."));
  Serial.println(F("Escribe 1 = Eco I, 2 = Eco II, 0 = Eco apagado. Espera LISTO."));
}

void loop() {
  if (!Serial.available()) return;
  const char command = Serial.read();
  const uint16_t* timings;
  switch (command) {
    case '0': timings = ecoOff; break;
    case '1': timings = ecoI; break;
    case '2': timings = ecoII; break;
    case '\r':
    case '\n': return;
    default:
      Serial.println(F("Orden invalida: usa 1, 2 o 0."));
      return;
  }
  Serial.print(F("TRANSMITIENDO ECO "));
  Serial.println(command);
  Serial.flush();
  IrSender.sendRaw_P(timings, 243, carrierKhz);
  digitalWrite(IR_SEND_PIN, LOW);
  Serial.println(F("LISTO: señal emitida; confirma la respuesta en el minisplit."));
}
